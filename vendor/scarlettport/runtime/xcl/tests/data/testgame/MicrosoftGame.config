<?xml version="1.0" encoding="utf-8"?>
<!-- Fake GDK package manifest for the XCL test title. -->
<Game configVersion="1">
  <Identity Name="XCL.TestTitle" Publisher="CN=XCL" Version="1.0.0.0"/>
  <ExecutableList>
    <Executable Name="xcl_testtitle.exe" TargetDeviceFamily="Scarlett" Id="Game"/>
  </ExecutableList>
  <ShellVisuals DefaultDisplayName="XCL Test Title" PublisherDisplayName="XCL"/>
  <!-- settings XCL takes from a title's manifest (values of a real title) -->
  <PersistentLocalStorage>
    <SizeMB>2048</SizeMB>
  </PersistentLocalStorage>
  <VirtualMachine>
    <SMTEnabled>true</SMTEnabled>
    <XboxLockhartTitleMemory>Advanced</XboxLockhartTitleMemory>
    <XboxAnacondaTitleMemory>Advanced</XboxAnacondaTitleMemory>
  </VirtualMachine>
</Game>
