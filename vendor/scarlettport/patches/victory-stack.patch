+         {left} not done now (VICTORY_COPY_BACK_ASYNC={}, lag {} presents)",
+        s[0],
+        s[1],
+        u8::from(memwait_samequeue()),
+        s[2],
+        s[3] / 1e3,
+        s[4],
+        s[5] / 1e3,
+        u8::from(read_settle_precise()),
+        s[6],
+        s[7] / 1e6,
+        s[8] / 1e3,
+        s[9],
+        s[10] / 1e3,
+        u8::from(copy_back_async()),
+        async_lag(),
+    );
+}
