+            }
+            let from = marker - 6;
+            let mut one = vec![0u8; n + 6];
+            file.seek(SeekFrom::Start(from as u64))?;
+            file.read_exact(&mut one)?;
+            if let Some(r) = record(&one, 6) {
+                each(&one, from as u64, &r);
+            }
+        }
