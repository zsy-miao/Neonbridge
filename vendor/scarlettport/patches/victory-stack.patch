+                                let part = (to - from).as_secs_f64() / hold.as_secs_f64();
+                                counts.add((x * part).round() as i64, (y * part).round() as i64);
+                            }
+                        }
+                        What::Wheel(steps) => {
+                            if last < *at && *at <= now {
+                                counts.add_wheel(steps);
+                            }
+                        }
+                    }
+                }
