+            file.seek(SeekFrom::Start((marker - 4) as u64))?;
+            file.read_exact(&mut head)?;
+            let word = |i: usize| u32::from_le_bytes(head[4 * i..4 * i + 4].try_into().expect("4 bytes")) as usize;
+            let n = word(0);
+            if n != word(2) || n < 12 || n > MAX_UNPACKED || marker + n > len {
