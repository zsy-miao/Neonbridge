+    /// A metadata block naming `digest` (graphics layout: 16-byte head,
+    /// then the 0x43 entry).
+    fn meta_naming(digest: [u8; 16]) -> Vec<u8> {
+        let mut m = Vec::new();
+        for w in [2u32, 0x24, 0x76, 0, 0x43] {
+            m.extend_from_slice(&w.to_le_bytes());
+        }
+        m.extend_from_slice(&digest);
+        m
+    }
