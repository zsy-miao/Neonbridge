+/// levels, format, samples).
+fn texture_shape(words: Option<[u32; 10]>, resource: &[u32; 14], unordered: bool, address: u64) -> Shape {
+    const TEXTURE1D: u32 = 2;
+    const TEXTURE3D: u32 = 4;
