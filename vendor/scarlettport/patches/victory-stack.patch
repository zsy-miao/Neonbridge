+            state.as_ptr() as usize,
+            0x1c,
+            state[0x1c..].as_ptr() as usize,
+            0x4,
+            code.as_ptr() as usize,
+            code.len(),
+            meta.as_ptr() as usize,
+            meta.len(),
+        ]
+    }
