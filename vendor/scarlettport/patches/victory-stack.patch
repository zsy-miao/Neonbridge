+            // buffer_store_format_xyzw v[1:4], v5, s[12:15], 0 idxen
+            words.extend([0xE01C_2000, 0x8003_0105]);
+        } else {
+            // buffer_store_dwordx4 v[1:4], off, s[12:15], 0
+            words.extend([0xE078_0000, 0x8003_0100]);
+        }
