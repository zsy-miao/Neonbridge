+        return None;
+    }
+    let count = u32_at(24)? as usize;
+    if bytes.len() != 28 + INDEX_ENTRY * count {
+        return None;
+    }
+    (0..count)
+        .map(|i| {
+            let at = 28 + INDEX_ENTRY * i;
+            Some((
+                bytes[at..at + 16].try_into().ok()?,
+                Place {
+                    packed_offset: u64_at(at + 16)?,
+                    packed_size: u32_at(at + 24)?,
+                    unpacked_size: u32_at(at + 28)?,
+                },
+            ))
+        })
+        .collect()
