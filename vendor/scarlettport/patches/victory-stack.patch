+                    let loaded = self.s.op(c, name, Attr::ReadNone, ty, 4, &args);
+                    let loaded = if float { self.as_int(loaded) } else { loaded };
+                    self.s.inputs[id].usage |= 1 << col;
+                    x = self.s.m.select(c, is, loaded, x);
+                }
+            }
+        }
