+/// `VICTORY_PSO_SHARE=1`: concurrent misses of one library name share one compile.
+fn share_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("VICTORY_PSO_SHARE").is_some_and(|v| v == "1"))
