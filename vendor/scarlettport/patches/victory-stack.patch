+    assert_ne!(mapped.dxil, bindless(Some((131_072, 737_853))).dxil);
+    assert_ne!(mapped.dxil, bindless(Some((65_536, 737_854))).dxil);
+    assert_eq!(plain.user_data, mapped.user_data);
