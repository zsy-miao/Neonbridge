+        fn parse(entry: &str) -> Option<(Duration, Duration, What)> {
+            let (at, rest) = entry.split_once(':')?;
+            let (what, hold) = match rest.split_once('*') {
+                Some((what, hold)) => (what, hold.trim().parse::<f64>().ok()?),
+                None => (rest, 0.2),
