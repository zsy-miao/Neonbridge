+            let gate = Arc::new(std::sync::Barrier::new(2));
+            queue(q).enqueue(Entry::Gate(Arc::clone(&gate)));
+            enqueue(q, refused(0x1001).as_ptr()); // submitted, cancelled below
+            status(q, s, 0);
+            submit(q);
+            enqueue(q, refused(0x1002).as_ptr()); // pending, cancelled below
