+fn letter_scancode(c: char) -> Option<(u32, i32)> {
+    let rows = [("QWERTYUIOP", 0x10u32), ("ASDFGHJKL", 0x1E), ("ZXCVBNM", 0x2C)];
+    rows.iter().find_map(|(row, base)| row.find(c).map(|i| (base + i as u32, c as i32)))
