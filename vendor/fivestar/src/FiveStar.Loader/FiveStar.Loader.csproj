<Project Sdk="Microsoft.NET.Sdk">
  <!-- Maps the console's x64 images on Windows and binds their Xbox-only imports to the shims in this project. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>fivestar-loader</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- A NativeAOT publish (-p:PublishAot=true, docs/aot.md) is self-contained by definition. -->
    <SelfContained Condition="'$(PublishAot)' != 'true'">false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CET shadow stacks fail-fast (0x30) when SEH resumes inside manually mapped code. The JIT host and the
         NativeAOT linker (/CETCOMPAT:NO) both honour it. -->
    <CETCompat>false</CETCompat>
    <!-- Trim and AOT analysis on every build, so the JIT build already fails on what NativeAOT cannot run. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The zlib inflater the DirectStorage queues decode archive chunks with. -->
    <ProjectReference Include="..\FiveStar.Formats\FiveStar.Formats.csproj" />
    <!-- Pipeline creation: the pipeline-cache state decoders, shader containers and program index. -->
    <ProjectReference Include="..\FiveStar.Shaders\FiveStar.Shaders.csproj" />
    <!-- Pipeline creation: the root signature of translated programs. -->
    <ProjectReference Include="..\FiveStar.Graphics\FiveStar.Graphics.csproj" />
    <!-- Lists the shim types at compile time (Shims/ShimTable.cs). It runs inside the compiler, so it is built without
         the publish settings of the loader. -->
    <ProjectReference Include="..\FiveStar.Loader.Generators\FiveStar.Loader.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" GlobalPropertiesToRemove="PublishAot;SelfContained;RuntimeIdentifier" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opus decoding for the xapu.dll queue (BSD-3-Clause, THIRD_PARTY_NOTICES.md). -->
    <PackageReference Include="Concentus" />
  </ItemGroup>

  <ItemGroup>
    <!-- The GC compacts the large object heap once fragmentation passes 50% of it (0 to 9, docs/debugging.md): the
         loader's managed commit is charged beside the game's on a machine whose commit is the limit. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FiveStar.Loader.Tests" />
    <InternalsVisibleTo Include="FiveStar.Benchmarks" />
  </ItemGroup>
</Project>
