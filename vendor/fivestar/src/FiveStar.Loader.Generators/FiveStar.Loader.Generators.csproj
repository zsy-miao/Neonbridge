<Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="PublishAot;SelfContained">
  <!-- Compile-time registration for the loader: lists the shim types so trimming and NativeAOT keep what ShimTable reads. -->
  <PropertyGroup>
    <!-- Roslyn loads generators as netstandard2.0 assemblies. -->
    <TargetFramework>netstandard2.0</TargetFramework>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <!-- A `dotnet publish -p:PublishAot=true` of the loader reaches this project through restore; it is never published. -->
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- At most the Roslyn of the oldest supported SDK, or the compiler refuses to load the generator. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
