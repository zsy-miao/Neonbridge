<Project Sdk="Microsoft.NET.Sdk">
  <!-- The `fivestar-dbg` command: runs a program under the Win32 debugging API and reports its exceptions, stacks and crash dumps. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>fivestar-dbg</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FiveStar.Debugger.Tests" />
  </ItemGroup>
</Project>
