<Project Sdk="Microsoft.NET.Sdk">
  <!-- Readers and writers for the console package's data: RPF9 archives, ttpf texture pages, PSO metadata, platform files. -->
  <PropertyGroup>
    <!-- MappedFileSource hands out spans over memory-mapped archives of up to 80 GB; the BCPack lane engines use pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Part of fivestar-loader: trim and AOT analysis on every build (docs/aot.md). -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FiveStar.Formats.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The BCPack decoder's tables (Ttpf/BcPack/BcPackTableReader.cs). -->
    <EmbeddedResource Include="Ttpf\BcPack\Tables\*.json" LogicalName="FiveStar.Formats.Ttpf.BcPack.Tables.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
