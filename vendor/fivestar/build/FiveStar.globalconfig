is_global = true
global_level = 100

# Code rules for every C# file, production and tests alike.
# CONTRIBUTING.md explains each one.

csharp_style_namespace_declarations = file_scoped:error
csharp_prefer_braces = true:error
csharp_preserve_single_line_blocks = true
csharp_preserve_single_line_statements = false
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_prefer_primary_constructors = false:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
dotnet_style_qualification_for_field = false:error
dotnet_style_readonly_field = true:error
dotnet_sort_system_directives_first = true

# The option suffixes above steer the editor; these make the build fail the same way.
# IDE0003 `this.`, IDE0005 unused using, IDE0011 braces, IDE0044 readonly field, IDE0073 file header,
# IDE0161 file-scoped namespace, CA1852 seal an internal type.
dotnet_diagnostic.IDE0003.severity = error
dotnet_diagnostic.IDE0005.severity = error
dotnet_diagnostic.IDE0011.severity = error
dotnet_diagnostic.IDE0044.severity = error
dotnet_diagnostic.IDE0073.severity = error
dotnet_diagnostic.IDE0161.severity = error
dotnet_diagnostic.CA1852.severity = error

# Vertical spacing and one statement per line. Only these StyleCop rules run.
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.LayoutRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.MaintainabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.NamingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.OrderingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.ReadabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpacingRules.severity = none
# SA1107 one statement per line
dotnet_diagnostic.SA1107.severity = error
# SA1500 a multi-line block's braces sit on their own lines
dotnet_diagnostic.SA1500.severity = error
# SA1501 a braced statement never sits on one line
dotnet_diagnostic.SA1501.severity = error
# SA1505 no blank line after an opening brace; SA1508 none before a closing brace; SA1509 none before an opening brace
dotnet_diagnostic.SA1505.severity = error
dotnet_diagnostic.SA1508.severity = error
dotnet_diagnostic.SA1509.severity = error
# SA1507 never two blank lines in a row
dotnet_diagnostic.SA1507.severity = error
# SA1510 no blank line before else, catch or finally
dotnet_diagnostic.SA1510.severity = error
# SA1513 a blank line after a closing brace, unless the next line closes or continues a block
dotnet_diagnostic.SA1513.severity = error
# SA1516 a blank line between members
dotnet_diagnostic.SA1516.severity = error
# SA1517 no blank lines at the start of a file; SA1518 the file ends with one newline
dotnet_diagnostic.SA1517.severity = error
dotnet_diagnostic.SA1518.severity = error

# Analyzer rules that do not fit this style.
dotnet_diagnostic.CA1002.severity = none
dotnet_diagnostic.CA1034.severity = none
# CA1051 public fields: structs keep them, as interop mirrors and vertex layouts need them; classes never do.
dotnet_code_quality.CA1051.exclude_structs = true
dotnet_diagnostic.CA1062.severity = none
dotnet_diagnostic.CA1305.severity = none
dotnet_diagnostic.CA1310.severity = none
dotnet_diagnostic.CA1707.severity = none
# CA1716 refuses Visual Basic keywords (Shared, Text) as names; the code is C# only.
dotnet_diagnostic.CA1716.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1815.severity = none
dotnet_diagnostic.CA1819.severity = none
# CA1859 asks factories to return concrete types; ports are returned as ports on purpose.
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA2007.severity = none
