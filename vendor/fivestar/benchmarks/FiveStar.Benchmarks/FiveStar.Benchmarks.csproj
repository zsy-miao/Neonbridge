<Project Sdk="Microsoft.NET.Sdk">
  <!-- Costs of the per-call and per-page paths: a call into a shim entry point, XMem allocations, task queue dispatch,
       the BCPack BC1 decoder. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- A synthetic BCPack BC1 stream of bcpack-rs (vendor/bcpack-rs/PROVENANCE.md). -->
    <EmbeddedResource Include="..\..\vendor\bcpack-rs\tests\vectors\synthetic_12.json" LogicalName="FiveStar.Benchmarks.Bc1Stream.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FiveStar.Formats\FiveStar.Formats.csproj" />
    <ProjectReference Include="..\..\src\FiveStar.Loader\FiveStar.Loader.csproj" />
  </ItemGroup>
</Project>
