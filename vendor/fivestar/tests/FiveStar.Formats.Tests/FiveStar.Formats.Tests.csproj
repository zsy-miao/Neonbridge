<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- The BCPack block-layer tests feed hand-made symbol vectors to the decoder's pointer-based sinks. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- The synthetic BCPack BC1 streams of bcpack-rs (vendor/bcpack-rs/PROVENANCE.md). -->
    <None Include="..\..\vendor\bcpack-rs\tests\vectors\*.json" Link="BcPackVectors\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FiveStar.Formats\FiveStar.Formats.csproj" />
  </ItemGroup>
</Project>
