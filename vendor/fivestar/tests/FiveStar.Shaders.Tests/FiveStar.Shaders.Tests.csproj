<Project Sdk="Microsoft.NET.Sdk">
  <!-- Translator tests: hand-written RDNA programs run on D3D12 WARP and compared with a reference model of the ISA. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Vortice.Direct3D12" />
    <PackageReference Include="Vortice.DXGI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FiveStar.Shaders\FiveStar.Shaders.csproj" />
  </ItemGroup>

  <!-- One D3D12 device at a time: WARP crashes the test host when test classes run in parallel. -->
  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Helper shaders (fullscreen / half-coverage VS, wave probes, GS pass-through VS), compiled by the tests. -->
  <ItemGroup>
    <EmbeddedResource Include="Shaders\*.hlsl" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
