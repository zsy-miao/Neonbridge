+// Mouse movement acts as a rate-controlled stick while the secondary button is held.
+// Keep the cursor inside the game on long turns, and restore it when aiming ends.
+class MouseLook {
+    HWND captured = nullptr;
+    POINT saved{}, center{};
+    ULONGLONG sampled = 0;
+    LONG dx = 0, dy = 0;
+    SHORT x = 0, y = 0;
+    std::mutex mutex;
+public:
+    void sample(HWND window, XINPUT_GAMEPAD& pad) {
+        std::lock_guard<std::mutex> lock(mutex);
+        if (captured && captured != window) captured = nullptr;
+        if (!window) return;
+        const bool aiming = key_down(VK_RBUTTON);
+        if (key_down(VK_LBUTTON)) {
+            if (aiming) pad.bRightTrigger = 255;
+            else pad.wButtons |= XINPUT_GAMEPAD_A;
+        }
+        if (!aiming) {
+            if (captured) {
+                SetCursorPos(saved.x, saved.y);
+                captured = nullptr;
+            }
+            return;
+        }
+
+        pad.bLeftTrigger = 255;
+        POINT position;
+        if (!GetCursorPos(&position)) return;
+        const auto now = GetTickCount64();
+        if (!captured) {
+            RECT client, clip;
+            if (!GetClientRect(window, &client) || !GetClipCursor(&clip) || IsRectEmpty(&clip)) return;
+            POINT local = position;
+            if (!ScreenToClient(window, &local) || !PtInRect(&client, local)) return;
+            center = {(client.right + client.left) / 2, (client.bottom + client.top) / 2};
+            if (!ClientToScreen(window, &center)) return;
+            center.x = std::clamp(center.x, clip.left, clip.right - 1);
+            center.y = std::clamp(center.y, clip.top, clip.bottom - 1);
+            if (!SetCursorPos(center.x, center.y)) return;
+            captured = window;
+            saved = position;
+            x = y = 0;
+            dx = dy = 0;
+            sampled = now;
+        } else {
+            if ((position.x != center.x || position.y != center.y) && SetCursorPos(center.x, center.y)) {
+                dx += position.x - center.x;
+                dy += center.y - position.y;
+            }
+            const auto elapsed = now - sampled;
+            if (elapsed >= 24) {
+                auto axis = [elapsed](LONG delta) {
+                    const auto speed = delta * 24000.0 / static_cast<double>(elapsed);
+                    return static_cast<SHORT>(std::clamp(speed, -32768.0, 32767.0));
+                };
+                x = axis(dx);
+                y = axis(dy);
+                dx = dy = 0;
+                sampled = now;
+            }
+        }
+        if (x) pad.sThumbRX = x;
+        if (y) pad.sThumbRY = y;
+    }
+};
+
+void mix_desktop(XINPUT_GAMEPAD& pad) {
+    static MouseLook mouse;
+    HWND window = GetForegroundWindow();
+    DWORD owner = 0;
+    GetWindowThreadProcessId(window, &owner);
+    if (owner != GetCurrentProcessId()) {
+        mouse.sample(nullptr, pad);
+        return;
+    }
+    mouse.sample(window, pad);
+    static constexpr struct { int key; WORD button; } bindings[] = {
+        {'I', XINPUT_GAMEPAD_DPAD_UP}, {'K', XINPUT_GAMEPAD_DPAD_DOWN},
+        {'J', XINPUT_GAMEPAD_DPAD_LEFT}, {'L', XINPUT_GAMEPAD_DPAD_RIGHT},
+        {'Z', XINPUT_GAMEPAD_A}, {VK_RETURN, XINPUT_GAMEPAD_A}, {'X', XINPUT_GAMEPAD_B},
+        {VK_ESCAPE, XINPUT_GAMEPAD_B}, {'C', XINPUT_GAMEPAD_X}, {'V', XINPUT_GAMEPAD_Y},
+        {'M', XINPUT_GAMEPAD_START}, {'N', XINPUT_GAMEPAD_BACK},
+        {'Q', XINPUT_GAMEPAD_LEFT_SHOULDER}, {'E', XINPUT_GAMEPAD_RIGHT_SHOULDER}
+    };
+    for (auto binding : bindings)
+        if (key_down(binding.key)) pad.wButtons |= binding.button;
+    // Any deliberate keyboard direction takes priority over the analog stick.
+    auto axis = [](int negative, int positive, SHORT current) -> SHORT {
+        const bool lower = key_down(negative), higher = key_down(positive);
+        if (!lower && !higher) return current;
+        if (lower && higher) return 0;
+        return lower ? -32768 : 32767;
+    };
+    pad.sThumbLX = axis('A', 'D', pad.sThumbLX);
+    pad.sThumbLY = axis('S', 'W', pad.sThumbLY);
+    pad.sThumbRX = axis(VK_LEFT, VK_RIGHT, pad.sThumbRX);
+    pad.sThumbRY = axis(VK_DOWN, VK_UP, pad.sThumbRY);
+    if (key_down('R')) pad.bLeftTrigger = 255;
+    if (key_down('F')) pad.bRightTrigger = 255;
+}
+
+bool read_port(DWORD port, XINPUT_STATE& state) {
+    const bool is_virtual = port == keyboard_slot;
+    if (is_virtual) state = {};
+    else if (XInputGetState(port, &state) != ERROR_SUCCESS) return false;
+    if (!desktop_enabled()) return !is_virtual;
+
+    // A one-player game can keep a device filter. Deliver both input sources to
+    // its first connected pad and preserve the identity/rumble of hardware ports.
+    XINPUT_STATE other{};
+    for (DWORD i = 0; i < port; ++i)
+        if (XInputGetState(i, &other) == ERROR_SUCCESS) return !is_virtual;
+    mix_desktop(state.Gamepad);
+    return true;
+}
