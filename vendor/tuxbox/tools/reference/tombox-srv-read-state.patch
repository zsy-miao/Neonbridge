+// Frosty's SetSRVs adds the command-context mask to all-shader or compute-only
+// reads for a flagged SRV. Ordinary desktop SRV reads cover these uses. Keep
+// all other encodings intact: the individual platform bits are undocumented.
+pub(super) fn shader_read_state(state: u32) -> u32 {
+    match state {
+        0x1200_00c0 => 0xc0,
+        0x1200_0040 => 0x40,
+        _ => state,
+    }
+}
