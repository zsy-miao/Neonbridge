+        let format = unsafe { *pdescs.add(8) };
+        let layout = unsafe { *pdescs.add(11) };
+        if dim == 3 && matches!(format, 70..=84 | 94..=99) && layout == 0 {
+            #[repr(C, align(8))]
+            struct ResourceDesc([u32; 14]);
+            let mut desc = ResourceDesc([0; 14]);
+            // The PC descriptor ends at flags. Its final four bytes are padding.
+            unsafe { core::ptr::copy_nonoverlapping(pdescs, desc.0.as_mut_ptr(), 13) };
