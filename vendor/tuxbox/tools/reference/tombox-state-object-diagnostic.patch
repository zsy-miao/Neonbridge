+/// Record the serialized ray state object requested by the guest. This diagnostic build
+/// returns E_NOTIMPL until it can supply a functional desktop state object for these bytes.
+///
+/// # Safety
+/// The caller supplies a readable span of `len` bytes, a valid IID, and writable COM out storage.
+unsafe extern "system" fn deserialize_state_object_x(
+    _this: *mut DeviceWrapper, bytecode: *const u8, len: u32, root: *mut c_void,
+    flags: u32, iid: *const Guid, out: *mut *mut c_void,
+) -> i32 {
+    if out.is_null() { return E_POINTER; }
+    // SAFETY: the COM caller provides a writable output pointer.
+    unsafe { out.write(core::ptr::null_mut()) };
+    if bytecode.is_null() || iid.is_null() || len == 0 { return E_POINTER; }
+    // SAFETY: the guest supplies the serialized object's byte span and readable IID for this call.
+    let (data, requested) = unsafe { (core::slice::from_raw_parts(bytecode, len as usize), &*iid) };
+    let hash = crate::shader_xlat::fnv1a(data);
+    let head = &data[..data.len().min(8)];
+    record("d3d12_xs", "DeserializeStateObjectX",
+        &format!("bytes={len} fnv1a64={hash:016x} prefix={head:02x?} root={} flags={flags:#x} iid={} E_NOTIMPL",
+                 !root.is_null(), guid_str(requested)));
+    compat_common::E_NOTIMPL
+}
