+#[repr(C)]
+struct IndirectArgumentDesc {
+    kind: u32,
+    parameters: [u32; 3],
+}
+
+#[repr(C)]
+struct CommandSignatureDesc {
+    byte_stride: u32,
+    argument_count: u32,
+    arguments: *const IndirectArgumentDesc,
+    node_mask: u32,
+}
+
+unsafe extern "system" fn create_command_signature(
+    this: *mut DeviceWrapper,
+    desc: *const CommandSignatureDesc,
+    root: *mut c_void,
+    iid: *const Guid,
+    out: *mut *mut c_void,
+) -> i32 {
+    // SAFETY: this device wrapper holds a live ID3D12Device. Slot 41 is
+    // ID3D12Device::CreateCommandSignature with the signature below.
+    let real = unsafe { (*this).real };
+    let create: unsafe extern "system" fn(
+        *mut c_void, *const CommandSignatureDesc, *mut c_void, *const Guid, *mut *mut c_void,
+    ) -> i32 = unsafe { core::mem::transmute(*real_vtbl(real).add(41)) };
+
+    // Frosty submits three single-argument dispatch signatures to this slot.
+    let guest = unsafe { desc.as_ref() }.filter(|d| {
+        d.argument_count == 1 && !d.arguments.is_null()
+    });
+    if let Some(guest) = guest {
+        // SAFETY: the caller supplies one D3D12_INDIRECT_ARGUMENT_DESC. Only
+        // its type is defined for dispatch operations; leave its union unread.
+        let guest_kind = unsafe { (*guest.arguments).kind };
+        // Frosty associates its global root signature with this dispatch. The
+        // desktop API requires a null root when no argument changes root state.
+        if guest_kind == 9 && guest.byte_stride == 104 && !root.is_null() {
+            let hr = unsafe { create(real, desc, core::ptr::null_mut(), iid, out) };
+            record("d3d12_xs", "CreateCommandSignature", &format!(
+                "argument=9 stride=104 root=omitted -> hr={hr:#010x}"
+            ));
+            return hr;
+        }
+        let host_kind = match (guest_kind, guest.byte_stride, root.is_null()) {
+            (105, 12, true) => Some(2),  // D3D12_INDIRECT_ARGUMENT_TYPE_DISPATCH
+            (107, 16, true) => Some(10), // D3D12_INDIRECT_ARGUMENT_TYPE_DISPATCH_MESH
+            _ => None,
+        };
+        if let Some(kind) = host_kind {
+            let argument = IndirectArgumentDesc { kind, parameters: [0; 3] };
+            let translated = CommandSignatureDesc {
+                byte_stride: guest.byte_stride,
+                argument_count: 1,
+                arguments: &argument,
+                node_mask: guest.node_mask,
+            };
+            // SAFETY: both temporary descriptors live through the COM call.
+            let hr = unsafe { create(real, &translated, root, iid, out) };
+            record("d3d12_xs", "CreateCommandSignature", &format!(
+                "argument={guest_kind}->{kind} stride={} -> hr={hr:#010x}", guest.byte_stride
+            ));
+            return hr;
+        }
+    }
+    unsafe { create(real, desc, root, iid, out) }
+}
