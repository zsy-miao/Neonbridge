+unsafe extern "system" fn shim_close(shim: &mut ListShim) -> i32 {
+    // An error in a void recording command is reported by Close. Keep the
+    // host list open on failure so even an erroneous submission is rejected.
+    if shim.build_error != 0 { return shim.build_error; }
+    let close: unsafe extern "system" fn(*mut c_void) -> i32 =
+        unsafe { core::mem::transmute(*REAL_VT_PTR.add(9)) };
+    unsafe { close(shim.real) }
+}
