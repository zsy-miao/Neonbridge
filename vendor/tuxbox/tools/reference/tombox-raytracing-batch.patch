+unsafe fn query_list(real: *mut c_void, iid: *const crate::device_wrap::Guid, out: *mut *mut c_void) -> i32 {
+    let methods = unsafe { *real.cast::<*const usize>() };
+    let query: unsafe extern "system" fn(*mut c_void, *const crate::device_wrap::Guid, *mut *mut c_void) -> i32 =
+        unsafe { core::mem::transmute(*methods) };
+    unsafe { query(real, iid, out) }
+}
+
+unsafe extern "system" fn shim_query(shim: *mut ListShim, iid: *const crate::device_wrap::Guid, out: *mut *mut c_void) -> i32 {
+    let real = unsafe { (*shim).real };
+    if iid.is_null() || unsafe { *iid != XBOX_LIST6 } {
+        return unsafe { query_list(real, iid, out) };
+    }
+    if out.is_null() { return 0x80004003u32 as i32; }
+    unsafe { out.write(core::ptr::null_mut()) };
+    // Frosty's Xbox List6 supplies batched builds at slot 131. Host List4
+    // provides the underlying command. The returned guest pointer retains
+    // a reference on the base list, as required by the shim Release thunk.
+    let mut list4 = core::ptr::null_mut();
+    let hr = unsafe { query_list(real, &LIST4, &mut list4) };
+    if hr < 0 { return hr; }
+    if list4.is_null() { return 0x80004002u32 as i32; }
+    unsafe {
+        let real_methods = *real.cast::<*const usize>();
+        let add_ref: unsafe extern "system" fn(*mut c_void) -> u32 = core::mem::transmute(*real_methods.add(1));
+        add_ref(real);
+        let methods = *list4.cast::<*const usize>();
+        let release: unsafe extern "system" fn(*mut c_void) -> u32 = core::mem::transmute(*methods.add(2));
+        release(list4);
+        out.write(shim.cast());
+    }
+    0
+}
