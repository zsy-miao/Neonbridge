+#[repr(C)]
+struct RaytracingBuild {
+    destination: u64,
+    inputs: [u64; 3],
+    source: u64,
+    scratch: u64,
+    extension: [u64; 4],
+}
+const _: () = assert!(size_of::<RaytracingBuild>() == 80);
