+unsafe extern "system" fn build_acceleration_structures(
+    shim: &mut ListShim, count: u32, entries: *const RaytracingBuild,
+) {
+    if count == 0 { return; }
+    if entries.is_null() { shim.build_error = 0x80070057u32 as i32; return; }
+    // The caller passes count 80-byte records. The first 48 bytes are the
+    // desktop build descriptor. Frosty zeroes the entire trailing 32 bytes.
+    let builds = unsafe { core::slice::from_raw_parts(entries, count as usize) };
+    if builds.iter().any(|b| b.extension != [0; 4]) {
+        record("d3d12_xs", "BuildAccelerationStructures", "unsupported extended record");
+        shim.build_error = 0x80004001u32 as i32;
+        return;
+    }
+    if builds.iter().any(|b| b.destination == 0 || b.scratch == 0 ||
+        (b.destination | b.scratch | b.source) & 255 != 0) {
+        record("d3d12_xs", "BuildAccelerationStructures", "invalid acceleration structure buffer addresses");
+        shim.build_error = 0x80070057u32 as i32;
+        return;
+    }
+    let mut list4 = core::ptr::null_mut();
+    let hr = unsafe { query_list(shim.real, &LIST4, &mut list4) };
+    if hr < 0 || list4.is_null() { shim.build_error = 0x80004002u32 as i32; return; }
+    // SAFETY: desktop List4 slot 72 consumes the 48-byte build prefix
+    // synchronously. No postbuild-info descriptors occur in this batch form.
+    unsafe {
+        let methods = *list4.cast::<*const usize>();
+        let build: unsafe extern "system" fn(*mut c_void, *const RaytracingBuild, u32, *const c_void) =
+            core::mem::transmute(*methods.add(72));
+        for entry in builds { build(list4, entry, 0, core::ptr::null()); }
+        let release: unsafe extern "system" fn(*mut c_void) -> u32 = core::mem::transmute(*methods.add(2));
+        release(list4);
+    }
+    static CALLS: AtomicUsize = AtomicUsize::new(0);
+    if CALLS.fetch_add(1, Ordering::Relaxed) < 8 {
+        let b = &builds[0];
+        record("d3d12_xs", "BuildAccelerationStructures", &format!(
+            "recorded {count} builds, first dest={:#x} scratch={:#x}", b.destination, b.scratch
+        ));
+    }
+}
