+struct DescriptorRanges<'a> {
+    starts: &'a [u64],
+    sizes: Option<&'a [u32]>,
+}
+
+impl DescriptorRanges<'_> {
+    // SAFETY: each non-null input array contains count elements for this call.
+    unsafe fn from_raw<'a>(count: u32, starts: *const u64, sizes: *const u32) -> Option<DescriptorRanges<'a>> {
+        if count == 0 { return Some(DescriptorRanges { starts: &[], sizes: None }); }
+        if starts.is_null() { return None; }
+        let len = count as usize;
+        Some(DescriptorRanges {
+            starts: unsafe { core::slice::from_raw_parts(starts, len) },
+            sizes: (!sizes.is_null()).then(|| unsafe { core::slice::from_raw_parts(sizes, len) }),
+        })
+    }
+
+    fn count(&self) -> u64 {
+        self.sizes.map_or(self.starts.len() as u64, |sizes| sizes.iter().map(|&n| u64::from(n)).sum())
+    }
+
+    fn handles(&self, increment: u64) -> impl Iterator<Item = u64> + '_ {
+        self.starts.iter().enumerate().flat_map(move |(index, &base)| {
+            let size = self.sizes.map_or(1, |sizes| sizes[index]);
+            (0..size).map(move |i| base + increment * u64::from(i))
+        })
+    }
+}
