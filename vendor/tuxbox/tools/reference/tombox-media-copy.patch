+unsafe extern "system" fn reset(this: &mut CopyList, alloc: Object, pso: Object) -> i32 {
+    let f: unsafe extern "system" fn(Object, Object, Object) -> i32 = method(this.real, 10);
+    let hr = f(this.real, alloc, pso);
+    if hr >= 0 {
+        this.clear_plane();
+        this.error = if crate::transient::set_allocator(this.real, alloc) {
+            0
+        } else {
+            INVALID
+        };
+    }
+    hr
+}
+unsafe extern "system" fn unsupported(this: &mut CopyList) -> i32 {
+    this.error = compat_common::E_NOTIMPL;
+    this.error
+}
+#[repr(C, align(8))]
+struct Desc([u8; 56]);
+impl Desc {
+    unsafe fn read(resource: Object) -> Self {
+        let mut result = Self([0; 56]);
+        let f: unsafe extern "system" fn(Object, *mut Desc) -> *mut Desc = method(resource, 10);
+        f(resource, &mut result);
+        result
+    }
+    fn width(&self) -> u64 {
+        u64::from_le_bytes(self.0[16..24].try_into().unwrap())
+    }
+    fn height(&self) -> u32 {
+        u32::from_le_bytes(self.0[24..28].try_into().unwrap())
+    }
+    fn format(&self) -> u32 {
+        u32::from_le_bytes(self.0[32..36].try_into().unwrap())
+    }
+    fn array(&self) -> u16 {
+        u16::from_le_bytes(self.0[28..30].try_into().unwrap())
+    }
+    fn mips(&self) -> u16 {
+        u16::from_le_bytes(self.0[30..32].try_into().unwrap())
+    }
+}
+#[repr(C, align(8))]
+struct Location {
+    resource: Object,
+    kind: u32,
+    padding: u32,
+    payload: [u8; 32],
+}
+impl Location {
+    fn index(&self) -> u32 {
+        u32::from_le_bytes(self.payload[..4].try_into().unwrap())
+    }
+}
+const _: () = assert!(size_of::<Location>() == 48);
+unsafe extern "system" fn copy(
+    this: &mut CopyList,
+    dst: *const Location,
+    x: u32,
+    y: u32,
+    z: u32,
+    source: *const Location,
+    region: *const u32,
+) {
+    if dst.is_null()
+        || source.is_null()
+        || (*dst).resource.is_null()
+        || (*source).resource.is_null()
+    {
+        this.error = POINTER;
+        return;
+    }
+    let f: unsafe extern "system" fn(
+        Object,
+        *const Location,
+        u32,
+        u32,
+        u32,
+        *const Location,
+        *const u32,
+    ) = method(this.real, 16);
+    let src = &*source;
+    let dst = &*dst;
+    if src.kind != 0 || dst.kind != 0 {
+        this.clear_plane();
+        f(this.real, dst, x, y, z, src, region);
+        return;
+    }
+    let sd = Desc::read(src.resource);
+    let dd = Desc::read(dst.resource);
+    let mut va = 0u64;
+    let mut size = 8u32;
+    let get: unsafe extern "system" fn(Object, &Guid, &mut u32, &mut u64) -> i32 =
+        method(src.resource, 3);
+    let placed_uv =
+        sd.format() == 49 && get(src.resource, &PLACEMENT, &mut size, &mut va) == 0 && size == 8;
+    if placed_uv && !this.nv12.is_null() {
+        if va != this.chroma_va
+            || src.index() != 0
+            || dd.format() != 49
+            || sd.width() != this.uv_width
+            || sd.height() != this.uv_height
+        {
+            this.error = INVALID;
+            return;
+        }
+        let mut plane = Location {
+            resource: this.nv12,
+            kind: 0,
+            padding: 0,
+            payload: [0; 32],
+        };
+        plane.payload[..4].copy_from_slice(&1u32.to_le_bytes());
+        f(this.real, dst, x, y, z, &plane, region);
+        // The original source is retained by the recording allocator through GPU completion.
+        this.clear_plane();
+        return;
+    }
+    this.clear_plane();
+    if sd.format() == 103
+        && sd.array() == 1
+        && sd.mips() == 1
+        && src.index() == 0
+        && dd.format() == 61
+    {
+        let gpu_va: unsafe extern "system" fn(Object) -> u64 = method(src.resource, 11);
+        // Retail computes AlignUp(luma width,256)*height*(arrayIndex+1)+GPUVA.
+        // Only the observed single-image NV12 allocation is supported here.
+        let pitch = (sd.width() + 255) & !255;
+        if let Some(offset) = pitch
+            .checked_mul(u64::from(sd.height()))
+            .and_then(|n| n.checked_add(gpu_va(src.resource)))
+        {
+            if !crate::transient::retain_media_source(this.real, src.resource) {
+                this.error = INVALID;
+                return;
+            }
+            this.chroma_va = offset;
+            this.uv_width = pitch / 2;
+            this.uv_height = sd.height() / 2;
+            reference(src.resource, 1);
+            this.nv12 = src.resource;
+        }
+    }
+    f(this.real, dst, x, y, z, src, region);
+}
+pub(super) unsafe fn tag_placement(resource: Object, desc: &[u8; 56], va: u64) {
+    if u32::from_le_bytes(desc[32..36].try_into().unwrap()) != 49 {
+        return;
+    }
+    let set: unsafe extern "system" fn(Object, &Guid, u32, &u64) -> i32 = method(resource, 4);
+    set(resource, &PLACEMENT, 8, &va);
+}
+unsafe extern "system" fn barriers(
+    this: &mut CopyList,
+    count: u32,
+    input: *const crate::barriers::Barrier,
+) {
+    if count == 0 {
+        return;
+    }
+    if input.is_null() {
+        this.error = POINTER;
+        return;
+    }
+    let original = std::slice::from_raw_parts(input, count as usize);
+    let f: unsafe extern "system" fn(Object, u32, *const crate::barriers::Barrier) =
+        method(this.real, 26);
+    let translated = crate::barriers::translate(original);
+    f(this.real, translated.len() as u32, translated.as_ptr());
+}
+static TABLE: OnceLock<[usize; 16]> = OnceLock::new();
+pub(super) unsafe fn wrap(real: Object, allocator: Object) -> Object {
+    let vt = TABLE.get_or_init(|| {
+        [
+            query as usize,
+            add_ref as usize,
+            release as usize,
+            private_data as usize,
+            set_data as usize,
+            set_interface as usize,
+            set_name as usize,
+            get_device as usize,
+            get_type as usize,
+            close as usize,
+            reset as usize,
+            unsupported as usize,
+            copy as usize,
+            unsupported as usize,
+            unsupported as usize,
+            barriers as usize,
+        ]
+    });
+    Box::into_raw(Box::new(CopyList {
+        vt: vt.as_ptr(),
+        real,
+        refs: AtomicU32::new(1),
+        error: if crate::transient::set_allocator(real, allocator) {
+            0
+        } else {
+            INVALID
+        },
+        nv12: core::ptr::null_mut(),
+        chroma_va: 0,
+        uv_width: 0,
+        uv_height: 0,
+    }))
+    .cast()
+}
+pub(super) unsafe fn unwrap(p: Object) -> Object {
+    if TABLE
+        .get()
+        .is_some_and(|vt| !p.is_null() && *p.cast::<*const usize>() == vt.as_ptr())
+    {
+        (*p.cast::<CopyList>()).real
+    } else {
+        p
+    }
+}
