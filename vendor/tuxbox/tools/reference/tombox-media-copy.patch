+//! Frosty's compact Xbox COPY-list interface, used to split NV12 for Electra.
+use crate::device_wrap::Guid;
+use core::ffi::c_void;
+use core::sync::atomic::{AtomicU32, Ordering};
+use std::sync::OnceLock;
+
+pub(super) const IID: Guid = Guid {
+    d1: 0x30bc77b9,
+    d2: 0x8379,
+    d3: 0x4b25,
+    d4: [0x95, 0xde, 0xb8, 0x58, 0x8c, 0x42, 0x27, 0x5d],
