+    d4: [0x8b, 0xa8, 0xb3, 0xae, 0x42, 0xa5, 0xa4, 0x55],
+};
+const UNKNOWN: Guid = Guid {
+    d1: 0,
+    d2: 0,
+    d3: 0,
+    d4: [0xc0, 0, 0, 0, 0, 0, 0, 0x46],
+};
+const OBJECT: Guid = Guid {
+    d1: 0xc4fec28f,
+    d2: 0x7966,
+    d3: 0x4e95,
+    d4: [0x9f, 0x94, 0xf4, 0x31, 0xcb, 0x56, 0xc3, 0xb8],
+};
+const CHILD: Guid = Guid {
+    d1: 0x905db94b,
+    d2: 0xa00c,
+    d3: 0x4140,
+    d4: [0x9d, 0xf5, 0x2b, 0x64, 0xca, 0x9e, 0xa3, 0x57],
+};
+const BASE: Guid = Guid {
+    d1: 0x7116d91c,
+    d2: 0xe7e4,
+    d3: 0x47ce,
+    d4: [0xb8, 0xc6, 0xec, 0x81, 0x68, 0xf4, 0x37, 0xe5],
+};
+const PLACEMENT: Guid = Guid {
+    d1: 0x2355f569,
+    d2: 0x610d,
+    d3: 0x48cc,
+    d4: [0xa4, 0x69, 0x43, 0x10, 0x52, 0xa7, 0xc3, 0x68],
+};
+const INVALID: i32 = 0x80070057u32 as i32;
+const POINTER: i32 = 0x80004003u32 as i32;
+const NO_INTERFACE: i32 = 0x80004002u32 as i32;
+
+#[repr(C)]
+struct CopyList {
+    vt: *const usize,
+    real: *mut c_void,
+    refs: AtomicU32,
+    error: i32,
+    nv12: *mut c_void,
+    chroma_va: u64,
+    uv_width: u64,
+    uv_height: u32,
+}
+type Object = *mut c_void;
+unsafe fn method<T: Copy>(obj: Object, index: usize) -> T {
+    let ptr = *(*obj.cast::<*const usize>()).add(index);
+    core::mem::transmute_copy(&ptr)
+}
+unsafe fn reference(obj: Object, slot: usize) {
+    let f: unsafe extern "system" fn(Object) -> u32 = method(obj, slot);
+    f(obj);
+}
+impl CopyList {
+    unsafe fn clear_plane(&mut self) {
+        if !self.nv12.is_null() {
+            reference(self.nv12, 2);
+            self.nv12 = core::ptr::null_mut();
+        }
+    }
+}
+unsafe extern "system" fn query(this: *mut CopyList, iid: *const Guid, out: *mut Object) -> i32 {
+    if out.is_null() {
+        return POINTER;
+    }
+    *out = core::ptr::null_mut();
+    if iid.is_null() {
+        return POINTER;
+    }
+    if [&IID, &UNKNOWN, &OBJECT, &CHILD, &BASE]
+        .into_iter()
+        .any(|id| *iid == *id)
+    {
+        add_ref(this);
+        *out = this.cast();
+        0
+    } else {
+        NO_INTERFACE
+    }
+}
+unsafe extern "system" fn add_ref(this: *mut CopyList) -> u32 {
+    (*this).refs.fetch_add(1, Ordering::Relaxed) + 1
+}
+unsafe extern "system" fn release(this: *mut CopyList) -> u32 {
+    let old = (*this).refs.fetch_sub(1, Ordering::Release);
+    if old == 1 {
+        core::sync::atomic::fence(Ordering::Acquire);
+        let mut list = Box::from_raw(this);
+        list.clear_plane();
+        reference(list.real, 2);
+    }
+    old - 1
+}
+macro_rules! forward {
+    ($name:ident,$index:expr) => {
+        #[unsafe(naked)]
+        unsafe extern "system" fn $name(){
+            core::arch::naked_asm!("mov rcx,[rcx+8]","mov rax,[rcx]","jmp qword ptr [rax+{offset}]",offset=const $index*8);
+        }
+    }
+}
+forward!(private_data, 3);
+forward!(set_data, 4);
+forward!(set_interface, 5);
+forward!(set_name, 6);
+forward!(get_device, 7);
+forward!(get_type, 8);
+unsafe extern "system" fn close(this: &mut CopyList) -> i32 {
+    if this.error != 0 {
+        return this.error;
+    }
+    let f: unsafe extern "system" fn(Object) -> i32 = method(this.real, 9);
+    f(this.real)
