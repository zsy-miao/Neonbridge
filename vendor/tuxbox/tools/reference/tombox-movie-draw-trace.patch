+/// The shader resource table rotates as decoded frames arrive. Retain just the
+/// two inputs for the most recent WakeUp draw and track subsequent transitions.
+unsafe fn track_film_planes(planes: [usize; 2]) {
+    let mut retained = PLANES.lock().unwrap();
+    if retained.iter().map(|t| t.res).eq(planes) { return; }
+    let mut pair = Vec::new();
+    for (slot, res) in planes.into_iter().enumerate() {
+        let mut desc = [0u8; 56];
+        vcall!(res as *mut c_void, 10, fn(*mut u8) -> *mut u8, desc.as_mut_ptr());
+        let width = u64::from_le_bytes(desc[16..24].try_into().unwrap());
+        let height = u32::from_le_bytes(desc[24..28].try_into().unwrap());
+        let fmt = u32::from_le_bytes(desc[32..36].try_into().unwrap());
+        if !matches!((slot,width,height,fmt), (0,3840,1600,60|61) | (1,1920,800,48|49)) { return; }
+        pair.push(Target { res, desc, order: 10000 + slot });
+    }
+    let mut states = STATES.lock().unwrap();
+    let states = states.get_or_insert_with(HashMap::new);
