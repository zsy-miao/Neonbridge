+/// Pixel t0 and t1 used by the optional film readback.
+pub fn movie_inputs(list: usize) -> Option<[usize; 2]> {
+    with(|state| {
+        let handle = *state.tables.get(&(list, false))?.first()?;
+        let heap = state.heaps.iter().find(|heap| heap.gpu != 0 && heap.inc != 0
+            && handle >= heap.gpu && handle < heap.gpu + (heap.count * heap.inc) as u64)?;
+        let index = (handle - heap.gpu) as usize / heap.inc;
+        if index + 1 >= heap.count { return None; }
+        let mut planes = [0; 2];
+        for (slot, plane) in planes.iter_mut().enumerate() {
+            let entry = state.descs.get(&(heap.cpu + (index + slot) * heap.inc))?;
+            let Desc::Srv { res, .. } = &entry.d else { return None };
+            if *res == 0 { return None; }
+            *plane = *res;
+        }
+        Some(planes)
+    })
+}
