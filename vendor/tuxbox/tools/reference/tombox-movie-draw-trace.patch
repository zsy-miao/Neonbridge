+pub unsafe fn movie_vertices(list: usize, address: u64) -> String {
+    with(|state| {
+        let mut out = String::new();
+        if let Some((base, buf)) = state.buffers.range(..=address).next_back() {
+            let offset = address - base;
+            if buf.heap_type == 2 && offset + 128 <= buf.size {
+                let obj = buf.res as *mut c_void;
+                let map: unsafe extern "system" fn(*mut c_void, u32, *const c_void, *mut *mut u8) -> i32 = core::mem::transmute(*vt(obj).add(8));
+                let unmap: unsafe extern "system" fn(*mut c_void, u32, *const c_void) = core::mem::transmute(*vt(obj).add(9));
+                let mut data = core::ptr::null_mut();
+                if map(obj, 0, core::ptr::null(), &mut data) >= 0 && !data.is_null() {
+                    out.push_str(&fmt_words(core::slice::from_raw_parts(data.add(offset as usize), 128)));
+                    let empty = [0usize; 2];
+                    unmap(obj, 0, empty.as_ptr().cast());
+                }
+            } else { out.push_str(&format!("buffer heap={} offset={offset:#x} size={}\n", buf.heap_type, buf.size)); }
+        }
+        if let Some(tables) = state.tables.get(&(list, false)) {
+            for (param, &handle) in tables.iter().enumerate() {
+                let Some(heap) = state.heaps.iter().find(|h| h.gpu != 0 && h.inc != 0 && handle >= h.gpu && handle < h.gpu + (h.count*h.inc) as u64) else { continue };
+                let index = (handle-heap.gpu) as usize / heap.inc;
+                for slot in 0..2 {
