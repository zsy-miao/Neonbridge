+    for old in retained.drain(..) {
+        states.remove(&old.res);
+        vcall!(old.res as *mut c_void, 2, fn() -> u32);
+    }
+    for target in &pair { states.insert(target.res, Some(0xc0)); }
+    *retained = pair;
