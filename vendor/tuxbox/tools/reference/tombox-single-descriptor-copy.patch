+    src_count: u32, src: *const u64, src_sizes: *const u32, heap_type: u32,
+) {
+    let real = unsafe { (*this).real };
+    let methods = unsafe { real_vtbl(real) };
+    // A null sizes array means every range contains exactly one descriptor.
+    // Use the equivalent desktop single-descriptor copy for this common shape.
+    if dst_count == 1 && src_count == 1 && !dst.is_null() && !src.is_null()
