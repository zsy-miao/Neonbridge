+            unsafe { core::mem::transmute(*methods.add(24)) };
+        unsafe { simple(real, 1, *dst, *src, heap_type) };
+    } else {
+        let copy: unsafe extern "system" fn(
+            *mut c_void, u32, *const u64, *const u32, u32, *const u64, *const u32, u32,
+        ) = unsafe { core::mem::transmute(*methods.add(23)) };
+        unsafe { copy(real, dst_count, dst, dst_sizes, src_count, src, src_sizes, heap_type) };
+    }
