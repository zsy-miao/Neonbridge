+/// Validate the declared DXIL program kind and the LLVM bitcode envelope. A
+/// Scarlett DXIL chunk may hold only a four-byte NOBC marker and an XDAT image.
+fn portable_mesh_stream_stage(shader: &[u8], kind: u32) -> bool {
+    let word = |bytes: &[u8], at: usize| -> Option<u32> {
+        Some(u32::from_le_bytes(bytes.get(at..at + 4)?.try_into().ok()?))
+    };
+    if shader.get(..4) != Some(b"DXBC") || word(shader, 24) != u32::try_from(shader.len()).ok() {
+        return false;
+    }
+    let Some(count) = word(shader, 28) else { return false };
+    let Some(toc) = shader.get(32..32 + count as usize * 4) else { return false };
+    for entry in toc.chunks_exact(4) {
+        let at = u32::from_le_bytes(entry.try_into().unwrap()) as usize;
+        if shader.get(at..at + 4) != Some(b"DXIL") { continue; }
+        let Some(size) = word(shader, at + 4) else { return false };
+        let Some(program) = shader.get(at + 8..at + 8 + size as usize) else { return false };
+        let (Some(version), Some(offset), Some(length)) =
+            (word(program, 0), word(program, 16), word(program, 20)) else { return false };
+        let bitcode = 8 + offset as usize;
+        return version >> 16 == kind && program.get(8..12) == Some(b"DXIL") && length >= 4
+            && word(program, 4).map(|n| n as usize * 4) == Some(program.len())
+            && program.get(bitcode..bitcode + length as usize).is_some_and(|bc| bc.starts_with(b"BC\xc0\xde"));
+    }
+    false
+}
