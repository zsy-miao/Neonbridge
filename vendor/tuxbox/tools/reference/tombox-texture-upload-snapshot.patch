+// The title may decommit a texture after VirtualQuery, or while other subresources
+// are being staged. Hash and detile the same owned bytes. A partial read is retried.
+fn snapshot(addr: usize, len: usize) -> Option<Vec<u8>> {
+    if !readable(addr, len) {
+        return None;
+    }
+    let mut bytes: Vec<u8> = Vec::new();
+    bytes.try_reserve_exact(len).ok()?;
+    let mut copied = 0;
+    // SAFETY: the destination has capacity for len bytes. The OS checks the
+    // source range. Expose the initialized bytes only after a complete read.
+    unsafe {
+        if ReadProcessMemory(GetCurrentProcess(), addr as *const c_void,
+                bytes.as_mut_ptr().cast(), len, &mut copied) == 0 || copied != len {
+            return None;
+        }
+        bytes.set_len(len);
+    }
+    Some(bytes)
 }
 
