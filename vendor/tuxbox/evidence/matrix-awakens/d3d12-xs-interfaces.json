          "checks": {
            "copy": "Copy errors and valid recording after Reset"
          }
        },
        {
          "slot": 26,
          "method": "ResourceBarrier",
          "identified": "copy",
          "checks": {
            "copy": "Transitions from shader read to copy destination and from copy destination to copy source on a placed texture"
          }
        },
        {
          "slot": 43,
          "method": "SetComputeRootShaderResourceView",
          "identified": "dxr",
          "checks": {
            "dxr": "Bound the TLAS and ray input to a linked guest pipeline"
          }
        },
        {
          "slot": 59,
          "method": "ExecuteIndirect",
          "identified": "profile",
          "checks": {
            "placed": "Indirect compute argument buffer and count controls",
            "mesh_gpu": "GPU count and argument buffers execute two 16-byte Xbox mesh dispatch records",
            "ray_commands": "Executed 104-byte indirect records from a nonzero offset and verified hit, miss and intersection data on NVIDIA and Radeon."
          }
        },
        {
          "slot": 67,
          "method": "FlushTextureCache",
          "identified": "startup",
          "checks": {
            "placed": "Global and range flush forms"
          }
        },
        {
          "slot": 83,
          "method": "CopyTextureRegionX",
          "identified": "texture",
          "checks": {
            "texture": "Depth and stencil planes",
            "copy": "Two-texel write to one placed RGBA8 mip and four-mip readback through an overlapping slice"
          }
        },
        {
          "slot": 84,
          "method": "Whole-resource copy",
          "identified": "chase",
          "checks": {
            "copy": "Zero-option buffer and texture copies, tiled RGBA8 writeback after a fence, and ordered alias readback across two queues"
          }
        },
        {
          "slot": 96,
          "method": "Async compute budget (title call)",
          "identified": "micropoly",
          "checks": {
            "async_budget_amd": "Dispatch after the default 24-byte budget, with null and nonzero controls",
            "async_budget_nvidia": "The same dispatch and rejected-budget controls on NVIDIA"
          }
        },
        {
          "slot": 117,
          "method": "BuildRaytracingAccelerationStructure",
          "identified": "ray_commands",
          "checks": {
            "ray_commands": "Built two triangle structures and their scene. On Radeon and GeForce the current and compacted sizes requested during the builds matched separate size queries. Four ray hits and a miss matched desktop D3D12."
          }
        },
        {
          "slot": 118,
          "method": "EmitRaytracingAccelerationStructurePostbuildInfo",
          "identified": "as_sizes",
          "checks": {
            "as_sizes": "Queried two rebuilt retail sphere BLASes in one call and verified compacted sizes and ray results on NVIDIA and Radeon."
          }
        },
        {
          "slot": 119,
          "method": "CopyRaytracingAccelerationStructure",
          "identified": "ray_copy",
          "checks": {
            "ray_copy": "Clone and compact two native BLASes via Xbox List4 and verify four hits and a miss. Serialized Xbox data requires translation.",
            "sphere": "Deserialized a packaged mesh on two adapters and preserved primitive IDs through 3,171 ray queries per adapter"
          }
        },
        {
          "slot": 120,
          "method": "SetPipelineState1",
          "identified": "dxr",
          "checks": {
            "dxr": "Bound the linked guest pipeline before two ray dispatches"
          }
        },
        {
          "slot": 121,
          "method": "DispatchRays",
          "identified": "dxr",
          "checks": {
            "dxr": "Read back occlusion, distance, instance and barycentrics for hits and misses"
          }
        },
        {
          "slot": 127,
          "method": "DispatchMesh",
          "identified": "mesh_abi",
          "checks": {
            "mesh_gpu": "Direct mesh and amplified mesh dispatch with asymmetric group dimensions, zero-group and invalid-size controls"
          }
        },
        {
          "slot": 131,
          "method": "BuildRaytracingAccelerationStructures",
          "identified": "sphere",
          "checks": {
            "sphere": "Submitted a TLAS with two instances of a rebuilt retail mesh and rejected malformed batches"
          }
        }
      ]
