+/// [`PLANE_STRIDE`] bytes apart, each listing `count` resources.
+unsafe fn second_plane(planes: u32, parameters: *const Plane, first: This) -> Option<This> {
+    if planes < 2 || parameters.is_null() {
+        return None;
