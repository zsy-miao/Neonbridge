+/// Neonbridge rt-prebuild.patch (ported from TuxBox runtime/d3d12
+/// device/ray_build.rs prebuild, GPL-3.0): GetRaytracingAccelerationStructure-
+/// PrebuildInfo (device slot 0x330). The Xbox call takes the same 24-byte inputs
+/// and writes the same three 64-bit sizes as DXR, so it is answered by the host
+/// ID3D12Device5. The title calls it on its intro path whatever OPTIONS5 says;
+/// left unwritten, the sizes trip the title's assert (int3). Sizes are zero when
+/// the inputs are not a plain array of triangle/AABB descs or there is no host.
+extern "system" fn rt_prebuild(
+    _: This,
+    inputs: *const windows::Win32::Graphics::Direct3D12::D3D12_BUILD_RAYTRACING_ACCELERATION_STRUCTURE_INPUTS,
+    out: *mut windows::Win32::Graphics::Direct3D12::D3D12_RAYTRACING_ACCELERATION_STRUCTURE_PREBUILD_INFO,
+) {
+    use windows::Win32::Graphics::Direct3D12::*;
+    use windows::core::Interface;
+    // SAFETY: the title passes its output struct or null.
+    let Some(out) = (unsafe { out.as_mut() }) else { return };
+    *out = Default::default();
+    static FIRST: std::sync::Once = std::sync::Once::new();
+    FIRST.call_once(|| tracing::info!("ray-tracing prebuild answered by the host device (Neonbridge rt-prebuild.patch)"));
+    // SAFETY: the title passes its inputs or null.
+    let Some(inputs) = (unsafe { inputs.as_ref() }) else { return };
+    let supported = |g: &D3D12_RAYTRACING_GEOMETRY_DESC| {
+        matches!(g.Type, D3D12_RAYTRACING_GEOMETRY_TYPE_TRIANGLES | D3D12_RAYTRACING_GEOMETRY_TYPE_PROCEDURAL_PRIMITIVE_AABBS)
+    };
+    let n = inputs.NumDescs as usize;
+    let valid = match inputs.Type {
+        D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_TOP_LEVEL => true,
+        D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL if n == 0 => true,
+        D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL if inputs.DescsLayout == D3D12_ELEMENTS_LAYOUT_ARRAY => {
+            // SAFETY: the title passes NumDescs descriptors.
+            let p = unsafe { inputs.Anonymous.pGeometryDescs };
+            !p.is_null() && unsafe { std::slice::from_raw_parts(p, n) }.iter().all(supported)
+        }
+        D3D12_RAYTRACING_ACCELERATION_STRUCTURE_TYPE_BOTTOM_LEVEL if inputs.DescsLayout == D3D12_ELEMENTS_LAYOUT_ARRAY_OF_POINTERS => {
+            // SAFETY: the title passes NumDescs pointers.
+            let p = unsafe { inputs.Anonymous.ppGeometryDescs };
+            !p.is_null() && unsafe { std::slice::from_raw_parts(p, n) }.iter().all(|g| unsafe { g.as_ref() }.is_some_and(supported))
+        }
+        _ => false,
+    };
+    if !valid {
+        return;
+    }
+    if let Some(host) = crate::host::host()
+        && let Ok(device) = host.device.cast::<ID3D12Device5>()
+    {
+        // SAFETY: validated inputs; out is the title's struct of the same layout.
+        unsafe { device.GetRaytracingAccelerationStructurePrebuildInfo(inputs, out) };
+    }
+}
