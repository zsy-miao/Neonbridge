+/// Neonbridge shared cache: the name every runtime of the victory family
+/// gives its own files in one shared cache folder (`VICTORY_CACHE_DIR`), so
+/// that their fixed-name files do not clash: `NEONBRIDGE_RUNTIME` (the
+/// launcher sets it to the tree name), else the first 12 hex digits of a
+/// hash of this executable (a build identity).
+pub fn runtime_id() -> &'static str {
+    static ID: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+    ID.get_or_init(|| {
+        if let Ok(v) = std::env::var("NEONBRIDGE_RUNTIME") {
+            let v: String = v
+                .trim()
+                .chars()
+                .map(|c| if c.is_ascii_alphanumeric() || c == '-' || c == '_' { c } else { '_' })
+                .collect();
+            if !v.is_empty() {
+                return v;
+            }
+        }
+        let bytes = std::env::current_exe().and_then(std::fs::read).unwrap_or_default();
+        let mut h: u64 = 0xcbf2_9ce4_8422_2325;
+        for b in bytes {
+            h ^= u64::from(b);
+            h = h.wrapping_mul(0x0100_0000_01b3);
+        }
+        format!("{:012x}", h >> 16)
+    })
+}
